DB_PATH=./config/db.sqlite
FE_PATH=./frontend/browser
DOWNLOADS_PATH=./downloads
PORT=3000
REDIS_HOST=localhost
REDIS_PORT=6379
# Start the bundled redis-server if REDIS_HOST is local and nothing listens yet
EMBEDDED_REDIS=true
# One folder per system inside DOWNLOADS_PATH ("{system}" = RomM structure A)
ORGANIZE_BY_SYSTEM=true
FOLDER_LAYOUT={system}
# Built-in browser (Firefox via noVNC) saving into the inbox
BROWSER_ENABLED=true
INBOX_PATH=./inbox
